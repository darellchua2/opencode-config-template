      "reasoning": "local-llm/local/gemma-4-E4B-q4_0",
      "fast": "local-llm/local/gemma-4-E4B-q4_0",
      "docs": "local-llm/local/gemma-4-E4B-q4_0",
      "vision": "local-llm/local/gemma-4-E4B-q4_0"
