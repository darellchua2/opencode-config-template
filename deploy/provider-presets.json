{
  "$comment": "Provider presets for the interactive picker (tui.mjs provider-picker flow) and the --provider CLI flag. Each preset is a complete {primary, tiers} map. Selecting a preset writes ~/.config/opencode/models.json from the chosen entry. Local presets (local-llm/vllm) map all tiers to the single locally-loaded model. Edit model IDs here as providers release newer versions.",
  "zai": {
    "label": "Z.AI (default)",
    "primary": "zai-coding-plan/glm-5.3",
    "tiers": {
      "reasoning": "zai-coding-plan/glm-5.3",
      "fast": "zai-coding-plan/glm-5-turbo",
      "docs": "zai-coding-plan/glm-4.7",
      "vision": "zai/glm-4.6v"
    }
  },
  "anthropic": {
    "label": "Anthropic (Claude)",
    "primary": "anthropic/claude-opus-4-8",
    "tiers": {
      "reasoning": "anthropic/claude-sonnet-4-6",
      "fast": "anthropic/claude-haiku-4-6",
      "docs": "anthropic/claude-haiku-4-6",
      "vision": "anthropic/claude-sonnet-4-6"
    }
  },
  "openai": {
    "label": "OpenAI (GPT)",
    "primary": "openai/gpt-5",
    "tiers": {
      "reasoning": "openai/gpt-5",
      "fast": "openai/gpt-5-mini",
      "docs": "openai/gpt-5-mini",
      "vision": "openai/gpt-5"
    }
  },
  "openrouter": {
    "$comment": "OpenRouter is a router - picker prompts for a model string per tier. This entry is a template; tui.mjs expands it by prompting.",
    "label": "OpenRouter (custom per tier)",
